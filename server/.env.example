# Template variables: code, valid minutes. Must match the approved template.
# Website OAuth: system browser, NOT embedded H5 / NOT native mobile SDK login.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
QQ_APP_ID=
QQ_APP_SECRET=
